@model OracleTestViewModel
@{
    ViewData["Title"] = "Oracle Test - University Payroll";
}
<main class="main-content">
    <div class="title-line">
        <div class="page-icon orange">OR</div>
        <div>
            <h1>Oracle Connection Test</h1>
            <p>Tests the C# Oracle.ManagedDataAccess.Core connection from appsettings.json</p>
        </div>
    </div>

    <section class="panel setup-card">
        <h2>@(Model.Success ? "Connection Successful" : "Connection Failed")</h2>
        <div class="notice @(Model.Success ? "success" : "error")">@Model.Message</div>
        <div class="credential-row"><b>Data Source</b><span>@Model.DataSource</span></div>
        <div class="credential-row"><b>Schema Owner</b><span>@Model.SchemaOwner</span></div>
        <div class="credential-row"><b>Department Count</b><span>@Model.DepartmentCount</span></div>
    </section>
</main>
