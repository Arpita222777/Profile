@model FacultyListViewModel
@{
    ViewData["Title"] = "Faculty - University Payroll";
}
<main class="main-content">
    <div class="title-line">
        <div class="page-icon blue">US</div>
        <div>
            <h1>Faculty</h1>
            <p>Faculty records from the Oracle FACULTY table</p>
        </div>
        <a class="primary-btn ml-auto" asp-controller="Faculty" asp-action="Add">Add Faculty</a>
    </div>

    <section class="panel setup-list-panel">
        <div class="table-top">
            <h2>Faculty List</h2>
            <input id="facultySearch" class="search-input" type="text" placeholder="Search faculty..." onkeyup="filterFacultyTable()" />
        </div>
        <div class="table-wrap">
            <table id="facultyTable" class="data-table">
                <thead>
                    <tr><th>ID</th><th>Name</th><th>Department</th><th>Designation</th><th>Rank</th><th>Email</th><th>Research Allowance</th></tr>
                </thead>
                <tbody>
                    @if (Model.Faculty.Count == 0)
                    {
                        <tr><td colspan="7">No faculty found.</td></tr>
                    }
                    @foreach (var faculty in Model.Faculty)
                    {
                        <tr>
                            <td>@faculty.Id</td>
                            <td><b>@faculty.FacultyName</b></td>
                            <td>@faculty.DepartmentName</td>
                            <td>@faculty.Designation</td>
                            <td>@faculty.AcademicRank</td>
                            <td>@faculty.Email</td>
                            <td>$@faculty.ResearchAllowance.ToString("N0")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</main>
