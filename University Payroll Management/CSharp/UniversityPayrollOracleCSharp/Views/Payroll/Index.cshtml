@model PayrollEntryViewModel
@{
    ViewData["Title"] = "Payroll - University Payroll";
}
<main class="main-content">
    <div class="title-line">
        <div class="page-icon green">$</div>
        <div>
            <h1>Payroll</h1>
            <p>Add a payroll transaction to Oracle PAYROLL_TRANSACTION</p>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Message))
    {
        <div class="notice @(Model.Success ? "success" : "error")">@Model.Message</div>
    }

    @if (Model.Faculty.Count == 0 || Model.PayrollStaff.Count == 0 || Model.FinanceOfficers.Count == 0)
    {
        <div class="notice error">Payroll requires at least one faculty member, payroll staff row, and finance officer row. Run the sample data script or add those records first.</div>
    }

    <section class="panel form-panel">
        <form asp-controller="Payroll" asp-action="Index" method="post">
            <div class="form-grid two">
                <div class="form-group">
                    <label asp-for="Form.FacultyId"></label>
                    <select asp-for="Form.FacultyId" id="faculty_id">
                        <option value="0">Select Faculty</option>
                        @foreach (var faculty in Model.Faculty)
                        {
                            <option value="@faculty.Id" data-department="@faculty.DepartmentName" data-research="@faculty.ResearchAllowance" data-base="0" data-house="0">@faculty.FacultyName - @faculty.DepartmentName</option>
                        }
                    </select>
                    <span asp-validation-for="Form.FacultyId" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Form.PaymentDate"></label>
                    <input asp-for="Form.PaymentDate" type="date" />
                    <span asp-validation-for="Form.PaymentDate" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Form.BaseSalary"></label>
                    <input asp-for="Form.BaseSalary" id="pay_base_salary" onkeyup="calculatePayrollCSharp()" onchange="calculatePayrollCSharp()" />
                    <span asp-validation-for="Form.BaseSalary" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Form.Allowances"></label>
                    <input asp-for="Form.Allowances" id="pay_other_allowances" onkeyup="calculatePayrollCSharp()" onchange="calculatePayrollCSharp()" />
                    <span asp-validation-for="Form.Allowances" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Form.Deductions"></label>
                    <input asp-for="Form.Deductions" id="other_deductions" onkeyup="calculatePayrollCSharp()" onchange="calculatePayrollCSharp()" />
                    <span asp-validation-for="Form.Deductions" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Form.Tax"></label>
                    <input asp-for="Form.Tax" id="tax_deduction" onkeyup="calculatePayrollCSharp()" onchange="calculatePayrollCSharp()" />
                    <span asp-validation-for="Form.Tax" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Form.PayrollStaffId"></label>
                    <select asp-for="Form.PayrollStaffId">
                        <option value="0">Select Payroll Staff</option>
                        @foreach (var staff in Model.PayrollStaff)
                        {
                            <option value="@staff.Id">@staff.Name</option>
                        }
                    </select>
                    <span asp-validation-for="Form.PayrollStaffId" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Form.FinanceOfficerId"></label>
                    <select asp-for="Form.FinanceOfficerId">
                        <option value="0">Select Finance Officer</option>
                        @foreach (var officer in Model.FinanceOfficers)
                        {
                            <option value="@officer.Id">@officer.Name</option>
                        }
                    </select>
                    <span asp-validation-for="Form.FinanceOfficerId" class="text-danger"></span>
                </div>
            </div>

            <div class="salary-breakdown">
                <div><span>Gross Salary</span><b>$<span id="gross_salary">0.00</span></b></div>
                <div><span>Total Deductions</span><b>$<span id="total_deductions">0.00</span></b></div>
                <div><span>Net Salary</span><b>$<span id="net_salary">0.00</span></b></div>
            </div>

            <button type="submit" class="primary-btn full-btn">Save Payroll Transaction</button>
        </form>
    </section>
</main>
@section Scripts {
<script>
function calculatePayrollCSharp(){
  var base = toNumber(document.getElementById('pay_base_salary').value);
  var allowances = toNumber(document.getElementById('pay_other_allowances').value);
  var deductions = toNumber(document.getElementById('other_deductions').value);
  var tax = toNumber(document.getElementById('tax_deduction').value);
  var gross = base + allowances;
  var totalDeductions = deductions + tax;
  var net = gross - totalDeductions;
  if(net < 0){ net = 0; }
  document.getElementById('gross_salary').innerHTML = gross.toFixed(2);
  document.getElementById('total_deductions').innerHTML = totalDeductions.toFixed(2);
  document.getElementById('net_salary').innerHTML = net.toFixed(2);
}
calculatePayrollCSharp();
</script>
}
