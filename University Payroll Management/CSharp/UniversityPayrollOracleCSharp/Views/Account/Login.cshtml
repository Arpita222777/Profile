@model LoginViewModel
@{
    ViewData["Title"] = "Login - University Payroll";
    ViewData["AuthPage"] = true;
}
<div class="login-page">
    <div class="login-card">
        <div class="lock-circle">UP</div>
        <h1>University Payroll</h1>
        <p class="subtitle">Oracle Database Login</p>

        <form asp-controller="Account" asp-action="Login" method="post" onsubmit="return validateLoginForm()">
            <label asp-for="Username"></label>
            <div class="input-icon">
                <span>U</span>
                <input asp-for="Username" id="email" autocomplete="username" />
            </div>
            <span asp-validation-for="Username" class="login-msg"></span>

            <label asp-for="Password"></label>
            <div class="input-icon">
                <span>*</span>
                <input asp-for="Password" id="password" autocomplete="current-password" />
            </div>
            <span asp-validation-for="Password" class="login-msg"></span>

            <label asp-for="Role"></label>
            <select asp-for="Role" id="role" onchange="updateLoginCredentialHint()">
                <option value="Admin">Admin</option>
                <option value="Payroll Staff">Payroll Staff</option>
                <option value="Auditor">Auditor</option>
            </select>

            <button type="submit">Login</button>
        </form>

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="login-msg">@Model.ErrorMessage</div>
        }

        <div class="credential-box">
            <div class="credential-title">Oracle accounts from your SQL script</div>
            <div id="selectedCredential" class="selected-credential">Admin: upms_admin / admin123</div>
            <div class="credential-row"><b>Admin</b><span>upms_admin / admin123</span></div>
            <div class="credential-row"><b>Payroll Staff</b><span>upms_operator / operator123</span></div>
            <div class="credential-row"><b>Auditor</b><span>upms_auditor / auditor123</span></div>
            <p>This C# version uses Oracle.ManagedDataAccess.Core, not PHP OCI8.</p>
        </div>
    </div>
</div>
@section Scripts {
    <script>updateLoginCredentialHint();</script>
}
