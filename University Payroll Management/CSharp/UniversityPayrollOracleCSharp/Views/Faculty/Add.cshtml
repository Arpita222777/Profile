@model AddFacultyViewModel
@{
    ViewData["Title"] = "Add Faculty - University Payroll";
}
<main class="main-content">
    <a class="back-link" asp-controller="Faculty" asp-action="Index">Back to Faculty</a>
    <div class="title-line compact">
        <div class="page-icon blue">+</div>
        <div>
            <h1>Add Faculty</h1>
            <p>Create an Oracle FACULTY record and optional FACULTY_PHONE record</p>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Message))
    {
        <div class="notice @(Model.Success ? "success" : "error")">@Model.Message</div>
    }

    <section class="panel form-panel">
        <form asp-controller="Faculty" asp-action="Add" method="post">
            <div class="form-grid two">
                <div class="form-group">
                    <label asp-for="Form.FacultyName"></label>
                    <input asp-for="Form.FacultyName" />
                    <span asp-validation-for="Form.FacultyName" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Form.FacultyEmail"></label>
                    <input asp-for="Form.FacultyEmail" />
                    <span asp-validation-for="Form.FacultyEmail" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Form.Phone"></label>
                    <input asp-for="Form.Phone" />
                </div>
                <div class="form-group">
                    <label asp-for="Form.DepartmentId"></label>
                    <select asp-for="Form.DepartmentId">
                        <option value="0">Select Department</option>
                        @foreach (var dept in Model.Departments)
                        {
                            <option value="@dept.Id">@dept.Name</option>
                        }
                    </select>
                    <span asp-validation-for="Form.DepartmentId" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Form.Designation"></label>
                    <select asp-for="Form.Designation">
                        @foreach (var designation in Model.Designations)
                        {
                            <option value="@designation.Id">@designation.Title</option>
                        }
                    </select>
                    <span asp-validation-for="Form.Designation" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Form.AcademicRank"></label>
                    <select asp-for="Form.AcademicRank">
                        <option>Senior</option>
                        <option>Mid</option>
                        <option>Junior</option>
                    </select>
                    <span asp-validation-for="Form.AcademicRank" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Form.BankInfo"></label>
                    <input asp-for="Form.BankInfo" placeholder="Example: Bank A-101" />
                    <span asp-validation-for="Form.BankInfo" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Form.ResearchAllowance"></label>
                    <input asp-for="Form.ResearchAllowance" />
                    <span asp-validation-for="Form.ResearchAllowance" class="text-danger"></span>
                </div>
            </div>
            <button type="submit" class="primary-btn full-btn">Save Faculty</button>
        </form>
    </section>
</main>
