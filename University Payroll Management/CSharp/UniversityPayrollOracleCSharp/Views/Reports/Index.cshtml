@model ReportsViewModel
@{
    ViewData["Title"] = "Reports - University Payroll";
    var months = System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.MonthNames.Where(m => !string.IsNullOrWhiteSpace(m)).ToList();
}
<main class="main-content">
    <div class="title-line">
        <div class="page-icon purple">RP</div>
        <div>
            <h1>Reports</h1>
            <p>Department-wise salary report from Oracle payroll transactions</p>
        </div>
    </div>

    <form class="panel report-filter" asp-controller="Reports" asp-action="Index" method="get">
        <div class="form-group">
            <label>Month</label>
            <select name="month">
                @for (var i = 1; i <= months.Count; i++)
                {
                    if (i == Model.MonthNumber)
                    {
                        <option value="@i" selected>@months[i - 1]</option>
                    }
                    else
                    {
                        <option value="@i">@months[i - 1]</option>
                    }
                }
            </select>
        </div>
        <div class="form-group">
            <label>Year</label>
            <input type="number" name="year" value="@Model.Year" />
        </div>
        <div class="form-group">
            <label>Search Department</label>
            <input type="text" name="search" value="@Model.Search" placeholder="Search..." />
        </div>
        <button type="button" class="secondary-btn" onclick="printReport()">Print</button>
        <button type="submit" class="primary-btn">Filter</button>
        <a class="primary-btn" asp-controller="Reports" asp-action="Export" asp-route-month="@Model.MonthNumber" asp-route-year="@Model.Year" asp-route-search="@Model.Search">Export CSV</a>
    </form>

    <div class="report-cards">
        <div class="report-card blue-card">
            <span>Total Faculty</span>
            <b>@Model.TotalFaculty</b>
            <small>Across matching departments</small>
        </div>
        <div class="report-card green-card">
            <span>Total Payroll</span>
            <b>$@Model.TotalPayroll.ToString("N0")</b>
            <small>@Model.Month @Model.Year expenditure</small>
        </div>
        <div class="report-card purple-card">
            <span>Average Salary</span>
            <b>$@Model.AverageSalary.ToString("N0")</b>
            <small>Per faculty member</small>
        </div>
    </div>

    <section class="panel report-table-panel">
        <h2>Department-wise Salary Report - @Model.Month @Model.Year</h2>
        <div class="table-wrap">
            <table class="data-table report-table">
                <thead>
                    <tr><th>Department</th><th>Faculty Count</th><th>Total Salary</th><th>Average Salary</th><th>% of Total</th></tr>
                </thead>
                <tbody>
                    @if (Model.Rows.Count == 0)
                    {
                        <tr><td colspan="5">No report data found.</td></tr>
                    }
                    @foreach (var row in Model.Rows)
                    {
                        var percent = Model.TotalPayroll > 0 ? row.TotalSalary / Model.TotalPayroll * 100 : 0;
                        <tr>
                            <td><b>@row.DepartmentName</b></td>
                            <td>@row.FacultyCount</td>
                            <td><b>$@row.TotalSalary.ToString("N0")</b></td>
                            <td>$@row.AverageSalary.ToString("N0")</td>
                            <td>@percent.ToString("N1")%</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td><b>TOTAL</b></td>
                        <td><b>@Model.TotalFaculty</b></td>
                        <td><b>$@Model.TotalPayroll.ToString("N0")</b></td>
                        <td><b>$@Model.AverageSalary.ToString("N0")</b></td>
                        <td><b>@(Model.TotalPayroll > 0 ? "100%" : "0%")</b></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </section>
</main>
